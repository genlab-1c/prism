// Проверки B26 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 4; Лог = "";
	СоздатьФикстуры();

	Т1 = Спр("Номенклатура", "Товар 1");
	Т2 = Спр("Номенклатура", "Товар 2");

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}("4600000000017");
		Если Р = Т1 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (точный штрихкод: ждали Товар 1); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}("  4600000000024 ");
		Если Р = Т2 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (штрихкод с пробелами по краям: ждали Товар 2); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}("0000000000000");
		Если Р = Неопределено Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (неизвестный штрихкод: ждали Неопределено); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}("");
		Если Р = Неопределено Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (пустой штрихкод: ждали Неопределено); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции
