// Проверки B24 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 5; Лог = "";
	СоздатьФикстуры();

	Техника = Спр("Номенклатура", "Техника");
	Холодильники = Спр("Номенклатура", "Холодильники");
	Крепеж = Спр("Номенклатура", "Крепеж");
	Основной = Спр("Склады", "Основной склад");
	Резервный = Спр("Склады", "Резервный склад");

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}(Техника, Основной, Дата(2026, 2, 1));
		Если Р = 15 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (Техника на 01.02 ждали 10 + 5 = 15, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}(Техника, Основной, Дата(2026, 3, 1));
		Если Р = 31 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (Техника на 01.03 ждали 6 + 25 = 31, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}(Холодильники, Основной, Дата(2026, 3, 1));
		Если Р = 25 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (вложенная группа на 01.03 ждали 25, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}(Крепеж, Резервный, Дата(2026, 3, 1));
		Если Р = 0 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (остатков нет, ждали 0, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 5
	Попытка
		Р = КодКандидата.{{ENTRY}}(Техника, Резервный, Дата(2026, 3, 1));
		Если Р = 100 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест5 FAIL (другой склад, ждали 100, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест5 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции
