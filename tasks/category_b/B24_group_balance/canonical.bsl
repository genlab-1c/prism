// Эталон B24: остатки на дату с отбором по складу и по группе В ИЕРАРХИИ.

Функция ОстатокПоГруппе(Группа, Склад, ДатаОстатка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатка, Склад = &Склад И Номенклатура В ИЕРАРХИИ (&Группа)) КАК Остатки";
	Запрос.УстановитьПараметр("ДатаОстатка", ДатаОстатка);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Группа", Группа);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;

КонецФункции
