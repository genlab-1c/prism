// Проверки B29 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 6; Лог = "";
	СоздатьФикстуры();

	Т1 = Спр("Номенклатура", "Товар 1");
	Т2 = Спр("Номенклатура", "Товар 2");
	Т3 = Спр("Номенклатура", "Товар 3");
	НачЯнв = Дата(2026, 1, 1); КонЯнв = Дата(2026, 1, 31);

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачЯнв, КонЯнв);
		Если Р.Количество() = 3 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (январь: ждали 3 строки, получено " + Р.Количество() + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачЯнв, КонЯнв);
		Если НайтиСтроку(Р, Т1) <> Неопределено И КолонкаПоИмени(Р, НайтиСтроку(Р, Т1), "План") = 1000 И КолонкаПоИмени(Р, НайтиСтроку(Р, Т1), "Факт") = 800 И КолонкаПоИмени(Р, НайтиСтроку(Р, Т1), "Откл") = -200 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (январь, Товар 1: ждали план 1000, факт 800, отклонение -200); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачЯнв, КонЯнв);
		Если НайтиСтроку(Р, Т2) <> Неопределено И КолонкаПоИмени(Р, НайтиСтроку(Р, Т2), "Факт") = 0 И КолонкаПоИмени(Р, НайтиСтроку(Р, Т2), "Откл") = -500 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (январь, Товар 2 только с планом: ждали факт 0, отклонение -500); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачЯнв, КонЯнв);
		Если НайтиСтроку(Р, Т3) <> Неопределено И КолонкаПоИмени(Р, НайтиСтроку(Р, Т3), "План") = 0 И КолонкаПоИмени(Р, НайтиСтроку(Р, Т3), "Откл") = 300 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (январь, Товар 3 только с фактом: ждали план 0, отклонение 300); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 5
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2026, 2, 1), Дата(2026, 2, 28));
		Если Р.Количество() = 2 И НайтиСтроку(Р, Т2) <> Неопределено И КолонкаПоИмени(Р, НайтиСтроку(Р, Т2), "Откл") = 700 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест5 FAIL (февраль: ждали 2 строки, Товар 2 отклонение 700); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест5 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 6
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2025, 1, 1), Дата(2025, 12, 31));
		Если Р.Количество() = 0 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест6 FAIL (период без данных: ждали пустую таблицу); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест6 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции

// Строка таблицы, в любой колонке которой стоит заданная ссылка.
Функция НайтиСтроку(ТЗ, Ссылка)
	Для Каждого Стр Из ТЗ Цикл
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			Если Стр[Колонка.Имя] = Ссылка Тогда
				Возврат Стр;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Первая числовая колонка строки — без привязки к имени колонки кандидата.
Функция ЧисловаяКолонка(ТЗ, Стр)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Значение = Стр[Колонка.Имя];
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Значение колонки, имя которой начинается с заданной части (без учёта регистра).
Функция КолонкаПоИмени(ТЗ, Стр, НачалоИмени)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Если СтрНачинаетсяС(ВРег(Колонка.Имя), ВРег(НачалоИмени)) Тогда
			Возврат Стр[Колонка.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
