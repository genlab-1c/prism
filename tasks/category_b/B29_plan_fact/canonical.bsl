// Эталон B29: полное соединение оборотов двух регистров, отсутствующая сторона заменяется нулём.

Функция ПланФактПродаж(ДатаНачала, ДатаОкончания) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ПланОбороты.Номенклатура, ФактОбороты.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ПланОбороты.СуммаОборот, 0) КАК План,
	|	ЕСТЬNULL(ФактОбороты.СуммаОборот, 0) КАК Факт,
	|	ЕСТЬNULL(ФактОбороты.СуммаОборот, 0) - ЕСТЬNULL(ПланОбороты.СуммаОборот, 0) КАК Отклонение
	|ИЗ
	|	РегистрНакопления.ПланПродаж.Обороты(&ДатаНачала, &ДатаОкончания, , ) КАК ПланОбороты
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, , ) КАК ФактОбороты
	|		ПО ПланОбороты.Номенклатура = ФактОбороты.Номенклатура";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
