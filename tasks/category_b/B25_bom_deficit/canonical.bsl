// Эталон B25: нормы из табличной части справочника сворачиваются во временную таблицу и соединяются с остатками.

Функция ДефицитМатериалов(Спецификация, КоличествоИзделий) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Материалы.Материал КАК Материал,
	|	СУММА(Материалы.Количество) КАК Норма
	|ПОМЕСТИТЬ Потребность
	|ИЗ
	|	Справочник.Спецификации.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Спецификация
	|СГРУППИРОВАТЬ ПО
	|	Материалы.Материал
	|;
	|ВЫБРАТЬ
	|	Потребность.Материал КАК Материал,
	|	Потребность.Норма * &КоличествоИзделий - ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Дефицит
	|ИЗ
	|	Потребность КАК Потребность
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						Потребность.Материал
	|					ИЗ
	|						Потребность КАК Потребность)) КАК Остатки
	|		ПО Потребность.Материал = Остатки.Номенклатура
	|ГДЕ
	|	Потребность.Норма * &КоличествоИзделий - ЕСТЬNULL(Остатки.КоличествоОстаток, 0) > 0";
	Запрос.УстановитьПараметр("Спецификация", Спецификация);
	Запрос.УстановитьПараметр("КоличествоИзделий", КоличествоИзделий);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
