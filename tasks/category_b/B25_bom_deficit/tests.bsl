// Проверки B25 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 4; Лог = "";
	СоздатьФикстуры();

	С1 = Спр("Спецификации", "Изделие А");
	С2 = Спр("Спецификации", "Пустая спецификация");
	М1 = Спр("Номенклатура", "Материал 1");
	М2 = Спр("Номенклатура", "Материал 2");
	М3 = Спр("Номенклатура", "Материал 3");

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}(С1, 5);
		Если Р.Количество() = 1 И НайтиСтроку(Р, М3) <> Неопределено И ЧисловаяКолонка(Р, НайтиСтроку(Р, М3)) = 20 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (5 изделий: ждали одну строку, Материал 3 дефицит 20); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}(С1, 10);
		Если Р.Количество() = 2 И НайтиСтроку(Р, М1) <> Неопределено И ЧисловаяКолонка(Р, НайтиСтроку(Р, М1)) = 10 И НайтиСтроку(Р, М3) <> Неопределено И ЧисловаяКолонка(Р, НайтиСтроку(Р, М3)) = 40 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (10 изделий: ждали Материал 1 дефицит 10 (нормы 2 + 1) и Материал 3 дефицит 40); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}(С1, 10);
		Если НайтиСтроку(Р, М2) = Неопределено Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (10 изделий: Материал 2 с нулевым дефицитом в результат не входит); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}(С2, 3);
		Если Р.Количество() = 0 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (пустая спецификация: ждали пустую таблицу); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции

// Строка таблицы, в любой колонке которой стоит заданная ссылка.
Функция НайтиСтроку(ТЗ, Ссылка)
	Для Каждого Стр Из ТЗ Цикл
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			Если Стр[Колонка.Имя] = Ссылка Тогда
				Возврат Стр;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Первая числовая колонка строки — без привязки к имени колонки кандидата.
Функция ЧисловаяКолонка(ТЗ, Стр)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Значение = Стр[Колонка.Имя];
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Значение колонки, имя которой начинается с заданной части (без учёта регистра).
Функция КолонкаПоИмени(ТЗ, Стр, НачалоИмени)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Если СтрНачинаетсяС(ВРег(Колонка.Имя), ВРег(НачалоИмени)) Тогда
			Возврат Стр[Колонка.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
