// Якорь оси O для B10: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «обход дерева по ссылке»: вместо В ИЕРАРХИИ одним запросом берём все конечные
// элементы справочника и у КАЖДОГО поднимаемся к корню, читая .Родитель через точку.
// Каждое такое чтение — отдельное обращение к объекту, поэтому число обращений растёт
// линейно с числом элементов в справочнике (см. perf.yaml, count: sdbl).

Функция ПолучитьЭлементыГруппы(Группа) Экспорт

	// Порядок по наименованию задаём в запросе — семантика та же, что у эталона.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		// Принадлежность группе — подъёмом по родителям через точку. Каждое обращение
		// к .Родитель читает объект элемента отдельным походом в СУБД.
		Текущий = Выборка.Ссылка;
		Принадлежит = Ложь;
		Пока ЗначениеЗаполнено(Текущий) Цикл
			Если Текущий = Группа Тогда
				Принадлежит = Истина;
				Прервать;
			КонецЕсли;
			Текущий = Текущий.Родитель;
		КонецЦикла;

		Если Принадлежит Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции
