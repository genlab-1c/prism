// Якорь оси O для B1: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «запрос в цикле»: вместо одного обращения к виртуальной таблице остатков
// сначала разворачиваем отбор в список товаров, а потом на КАЖДЫЙ товар выполняем свой
// запрос остатка. Число обращений растёт линейно с числом товаров под отбором
// (см. perf.yaml, count: sdbl). Ответ совпадает с эталоном: строка появляется только
// у тех товаров, по которым в регистре есть движения.

Функция ПолучитьОстаткиТоваров(МассивНоменклатуры, Склад, ГруппаНоменклатуры = Неопределено) Экспорт

	// Шаг 1. Определяем, по каким товарам считать. Явный массив имеет приоритет,
	// иначе разворачиваем группу вместе с подгруппами.
	Товары = Новый Массив;
	Если МассивНоменклатуры <> Неопределено И МассивНоменклатуры.Количество() > 0 Тогда
		Для Каждого Товар Из МассивНоменклатуры Цикл
			Товары.Добавить(Товар);
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ГруппаНоменклатуры) Тогда
		ЗапросГруппы = Новый Запрос;
		ЗапросГруппы.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ЛОЖЬ
		|	И Номенклатура.Ссылка В ИЕРАРХИИ (&Группа)";
		ЗапросГруппы.УстановитьПараметр("Группа", ГруппаНоменклатуры);
		ВыборкаГруппы = ЗапросГруппы.Выполнить().Выбрать();
		Пока ВыборкаГруппы.Следующий() Цикл
			Товары.Добавить(ВыборкаГруппы.Ссылка);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));

	// Ни массива, ни группы — как и у эталона, отбор вырождается в «весь склад».
	Если Товары.Количество() = 0 И Не ЗначениеЗаполнено(ГруппаНоменклатуры) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(Остатки.ВНаличииОстаток, 0) КАК Остаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК Остатки";
		Запрос.УстановитьПараметр("Склад", Склад);
		Возврат Запрос.Выполнить().Выгрузить();
	КонецЕсли;

	// Шаг 2. Остаток по каждому товару — СВОИМ запросом. Это и есть капкан.
	Для Каждого Товар Из Товары Цикл

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(Остатки.ВНаличииОстаток, 0) КАК Остаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|		, Склад = &Склад И Номенклатура = &Номенклатура) КАК Остатки";
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.УстановитьПараметр("Номенклатура", Товар);

		Выборка = Запрос.Выполнить().Выбрать();
		// Движений нет → эталон такой строки не отдаёт, и мы тоже.
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Номенклатура = Выборка.Номенклатура;
			НоваяСтрока.Остаток = Выборка.Остаток;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции
