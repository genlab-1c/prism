// Якорь оси O для B8: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «запрос в цикле»: вместо одного обращения к виртуальной таблице остатков и
// оборотов перебираем номенклатуру и на КАЖДЫЙ товар выполняем свой запрос. Число
// обращений растёт линейно с числом товаров (см. perf.yaml, count: sdbl).
// Ответ совпадает с эталоном: строка появляется только там, где виртуальная таблица
// что-то отдаёт (были остатки или движения в периоде).

Функция ПолучитьОстаткиИОбороты(НачалоПериода, КонецПериода, Склад = Неопределено) Экспорт

	// Справочник в этой задаче неиерархический — групп нет.
	ЗапросНоменклатуры = Новый Запрос;
	ЗапросНоменклатуры.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("НачальныйОстаток", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Приход", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Расход", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КонечныйОстаток", Новый ОписаниеТипов("Число"));

	УсловиеСклада = ?(ЗначениеЗаполнено(Склад), " И Склад = &Склад", "");

	ВыборкаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выбрать();
	Пока ВыборкаНоменклатуры.Следующий() Цикл

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ОстаткиИОбороты.КоличествоНачальныйОстаток, 0) КАК НачальныйОстаток,
		|	ЕСТЬNULL(ОстаткиИОбороты.КоличествоПриход, 0) КАК Приход,
		|	ЕСТЬNULL(ОстаткиИОбороты.КоличествоРасход, 0) КАК Расход,
		|	ЕСТЬNULL(ОстаткиИОбороты.КоличествоКонечныйОстаток, 0) КАК КонечныйОстаток
		|ИЗ
		|	РегистрНакопления.ДвиженияТоваров.ОстаткиИОбороты(
		|		&НачалоПериода, &КонецПериода, , ,
		|		Номенклатура = &Номенклатура" + УсловиеСклада + ") КАК ОстаткиИОбороты";

		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("Номенклатура", ВыборкаНоменклатуры.Ссылка);
		Если ЗначениеЗаполнено(Склад) Тогда
			Запрос.УстановитьПараметр("Склад", Склад);
		КонецЕсли;

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Номенклатура = Выборка.Номенклатура;
			НоваяСтрока.НачальныйОстаток = Выборка.НачальныйОстаток;
			НоваяСтрока.Приход = Выборка.Приход;
			НоваяСтрока.Расход = Выборка.Расход;
			НоваяСтрока.КонечныйОстаток = Выборка.КонечныйОстаток;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции
