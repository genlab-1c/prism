// Проверки B8 — родной формат раннера категории B (v1).
// Модуль «Тесты» собирает харнесс: СоздатьФикстуры() и Спр() генерируются из
// fixtures.yaml, ниже — только проверки. {{ENTRY}} — имя функции кандидата
// (детекция как в категории A); код кандидата — общий модуль «КодКандидата».
// Контракт: ПрогнатьТест() возвращает строку "PASSED=n;TOTAL=m;<лог>".
//
// Было два теста, и второй арифметически следовал из первого: конечный остаток = начальный
// плюс приход, расхода в данных не было вовсе. Поэтому исход выходил бинарным (21 запись
// 2/2, 20 записей 0/2, ни одной промежуточной), а колонку «Расход» можно было захардкодить
// нулём и пройти всё. Плюс необязательность параметра «склад» не проверялась ни разу,
// хотя условие её требует.
//
// Теперь пять независимых проверок, каждая про своё требование условия:
//   1. начальный остаток и приход (границы периода);
//   2. расход;
//   3. конечный остаток с учётом расхода;
//   4. товар БЕЗ начального остатка (ЕСТЬNULL, строка не должна теряться);
//   5. вызов БЕЗ склада — данные обоих складов.
//
// Имена колонок у кандидата могут отличаться (КоличествоНачальныйОстаток и т.п.) —
// числовые колонки ищем УСТОЙЧИВО, по вхождению подстроки в имя колонки.
// Тест 5 не навязывает форму результата: складывает значение по всем строкам товара,
// поэтому проходит и при агрегации по номенклатуре, и при строке на каждый склад.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 5; Лог = "";
	СоздатьФикстуры();

	НачалоПериода = Дата(2026, 2, 1);
	// КонецДня — иначе движение на 28.02 (00:00:00) отсечётся границей и приход
	// недосчитается: типичная ловушка «конца периода» виртуальной таблицы.
	КонецПериода  = КонецДня(Дата(2026, 2, 28));
	Склад  = Спр("Склады", "Основной склад");
	Товар  = Спр("Номенклатура", "Товар 1");
	Товар2 = Спр("Номенклатура", "Товар 2");

	// Тест 1: границы периода. Движение 10.01 → начальный остаток 10;
	// движения 05.02 и 28.02 → приход 4+6=10 (28.02 попадает только с КонецДня).
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачалоПериода, КонецПериода, Склад);
		Стр = НайтиСтроку(Р, "Номенклатура", Товар);
		Если Стр = Неопределено Тогда
			Лог = Лог + "тест1 FAIL (строка Товар1 не найдена); ";
		Иначе
			НачОст = КолонкаПоПодстроке(Р, Стр, "НАЧАЛЬНЫЙОСТАТОК", "НАЧ");
			Приход = КолонкаПоПодстроке(Р, Стр, "ПРИХОД", "");
			Если НачОст = 10 И Приход = 10 Тогда
				Прошло = Прошло + 1;
			Иначе
				Лог = Лог + "тест1 FAIL (НачОст=" + Строка(НачОст) + " Приход=" + Строка(Приход) + ", ждали 10 и 10); ";
			КонецЕсли;
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2: расход. Движение 15.02 на 3 единицы — колонка обязана его показать,
	// а не остаться нулевой.
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачалоПериода, КонецПериода, Склад);
		Стр = НайтиСтроку(Р, "Номенклатура", Товар);
		Если Стр = Неопределено Тогда
			Лог = Лог + "тест2 FAIL (строка Товар1 не найдена); ";
		Иначе
			Расход = КолонкаПоПодстроке(Р, Стр, "РАСХОД", "");
			Если Расход = 3 Тогда
				Прошло = Прошло + 1;
			Иначе
				Лог = Лог + "тест2 FAIL (Расход=" + Строка(Расход) + ", ждали 3); ";
			КонецЕсли;
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3: конечный остаток с учётом расхода = 10 + 10 − 3 = 17.
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачалоПериода, КонецПериода, Склад);
		Стр = НайтиСтроку(Р, "Номенклатура", Товар);
		Если Стр = Неопределено Тогда
			Лог = Лог + "тест3 FAIL (строка Товар1 не найдена); ";
		Иначе
			КонОст = КолонкаПоПодстроке(Р, Стр, "КОНЕЧНЫЙОСТАТОК", "КОН");
			Если КонОст = 17 Тогда
				Прошло = Прошло + 1;
			Иначе
				Лог = Лог + "тест3 FAIL (КонОст=" + Строка(КонОст) + ", ждали 17); ";
			КонецЕсли;
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4: товар БЕЗ начального остатка. Строка обязана присутствовать с нулём,
	// а не исчезнуть (ЕСТЬNULL вместо потери строки соединением).
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачалоПериода, КонецПериода, Склад);
		Стр = НайтиСтроку(Р, "Номенклатура", Товар2);
		Если Стр = Неопределено Тогда
			Лог = Лог + "тест4 FAIL (Товар2 потерян: нет начального остатка, но строка обязана быть); ";
		Иначе
			НачОст = КолонкаПоПодстроке(Р, Стр, "НАЧАЛЬНЫЙОСТАТОК", "НАЧ");
			КонОст = КолонкаПоПодстроке(Р, Стр, "КОНЕЧНЫЙОСТАТОК", "КОН");
			Если (НачОст = 0 ИЛИ НачОст = Неопределено) И КонОст = 7 Тогда
				Прошло = Прошло + 1;
			Иначе
				Лог = Лог + "тест4 FAIL (Товар2: НачОст=" + Строка(НачОст) + " КонОст=" + Строка(КонОст) + ", ждали 0 и 7); ";
			КонецЕсли;
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 5: склад НЕОБЯЗАТЕЛЕН. Без него в результат попадают оба склада:
	// конечный остаток Товара1 суммарно 17 (Основной) + 5 (Резервный) = 22.
	// Форму результата не навязываем — складываем по всем строкам товара.
	Попытка
		Р = КодКандидата.{{ENTRY}}(НачалоПериода, КонецПериода);
		Итог = СуммаПоТовару(Р, "Номенклатура", Товар, "КОНЕЧНЫЙОСТАТОК", "КОН");
		Если Итог = 22 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест5 FAIL (без склада КонОст Товара1 = " + Строка(Итог) + ", ждали 22); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест5 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции

// Поиск строки ТЗ по колонке, чьё имя содержит ИскомоеИмя, со значением = ЗначениеОтбора.
// Имя колонки сопоставляем по вхождению (без учёта регистра) — у кандидата может быть
// «Номенклатура», но на всякий случай ищем устойчиво.
Функция НайтиСтроку(ТЗ, ИскомоеИмя, ЗначениеОтбора)
	ИмяКолонки = ИмяКолонкиПоПодстроке(ТЗ, ВРег(ИскомоеИмя), "");
	Если ИмяКолонки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Стр Из ТЗ Цикл
		Если Стр[ИмяКолонки] = ЗначениеОтбора Тогда
			Возврат Стр;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Сумма числовой колонки по ВСЕМ строкам товара. Нужна там, где склад не задан:
// кандидат вправе как агрегировать по номенклатуре, так и вернуть строку на склад,
// и проверка не должна навязывать одну из форм.
Функция СуммаПоТовару(ТЗ, ИмяОтбора, ЗначениеОтбора, Подстрока1, Подстрока2)
	ИмяКлюча = ИмяКолонкиПоПодстроке(ТЗ, ВРег(ИмяОтбора), "");
	ИмяЗначения = ИмяКолонкиПоПодстроке(ТЗ, Подстрока1, Подстрока2);
	Если ИмяКлюча = Неопределено ИЛИ ИмяЗначения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Итог = 0;
	Для Каждого Стр Из ТЗ Цикл
		Если Стр[ИмяКлюча] = ЗначениеОтбора Тогда
			Итог = Итог + Стр[ИмяЗначения];
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Имя колонки ТЗ, содержащей одну из подстрок (без учёта регистра). Сначала ищем по
// Подстрока1, затем по Подстрока2 (запасной вариант, например короткое «Нач»/«Кон»).
// Пустая подстрока пропускается.
Функция ИмяКолонкиПоПодстроке(ТЗ, Подстрока1, Подстрока2)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		ИмяВРег = ВРег(Колонка.Имя);
		Если Не ПустаяСтрока(Подстрока1) И Найти(ИмяВРег, ВРег(Подстрока1)) > 0 Тогда
			Возврат Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	Если Не ПустаяСтрока(Подстрока2) Тогда
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			Если Найти(ВРег(Колонка.Имя), ВРег(Подстрока2)) > 0 Тогда
				Возврат Колонка.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Числовое значение строки из колонки, чьё имя содержит подстроку (без учёта регистра).
// Возврат Неопределено, если подходящей колонки нет.
Функция КолонкаПоПодстроке(ТЗ, Строка, Подстрока1, Подстрока2)
	ИмяКолонки = ИмяКолонкиПоПодстроке(ТЗ, Подстрока1, Подстрока2);
	Если ИмяКолонки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строка[ИмяКолонки];
КонецФункции
