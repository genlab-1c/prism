// Проверки B21 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 4; Лог = "";
	СоздатьФикстуры();

	К1 = Спр("Контрагенты", "ООО Альфа");
	К2 = Спр("Контрагенты", "ООО Бета");

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}(К1, Дата(2026, 2, 1));
		Если Р = 300 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (на 01.02 ждали 300: Новый 100 и ВРаботе 200, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}(К1, Дата(2026, 3, 1));
		Если Р = 1900 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (на 01.03 ждали 1900, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}(К2, Дата(2026, 3, 1));
		Если Р = 0 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (контрагент без заказов, ждали 0, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}(К1, Дата(2026, 1, 10));
		Если Р = 0 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (отгрузка в день контроля не просрочена, ждали 0, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции
