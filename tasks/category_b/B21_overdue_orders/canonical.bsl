// Эталон B21: отбор по значениям перечисления и по дате в одном запросе к справочнику.

Функция СуммаПросроченныхЗаказов(Контрагент, ДатаКонтроля) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Заказы.Сумма), 0) КАК Сумма
	|ИЗ
	|	Справочник.Заказы КАК Заказы
	|ГДЕ
	|	Заказы.Контрагент = &Контрагент
	|	И Заказы.ДатаОтгрузки < &ДатаКонтроля
	|	И Заказы.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.Новый), ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.ВРаботе))";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДатаКонтроля", ДатаКонтроля);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;
	Возврат 0;

КонецФункции
