// Якорь оси O для B14: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «запрос в цикле»: вместо одного соединения двух виртуальных таблиц идём по
// переданному массиву и на КАЖДЫЙ товар делаем свой запрос (наличие + резерв). Число
// обращений растёт линейно с размером массива (см. perf.yaml, count: sdbl).
// Семантика сохранена: товар без резерва не исчезает (резерв трактуется как 0), а товар
// без наличия строки не даёт — как и левое соединение у эталона.

Функция ПолучитьСвободныйОстаток(МассивНоменклатуры, Склад) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Свободно", Новый ОписаниеТипов("Число"));

	Если МассивНоменклатуры = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Товар Из МассивНоменклатуры Цикл

		// Запрос 1: наличие по товару.
		ЗапросНаличия = Новый Запрос;
		ЗапросНаличия.Текст =
		"ВЫБРАТЬ
		|	Наличие.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(Наличие.ВНаличииОстаток, 0) КАК ВНаличии
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|		, Склад = &Склад И Номенклатура = &Номенклатура) КАК Наличие";
		ЗапросНаличия.УстановитьПараметр("Склад", Склад);
		ЗапросНаличия.УстановитьПараметр("Номенклатура", Товар);

		ВыборкаНаличия = ЗапросНаличия.Выполнить().Выбрать();
		Если Не ВыборкаНаличия.Следующий() Тогда
			// Нет наличия — левое соединение у эталона строки бы не дало.
			Продолжить;
		КонецЕсли;

		// Запрос 2: резерв по тому же товару — ещё одно обращение на итерацию.
		ЗапросРезерва = Новый Запрос;
		ЗапросРезерва.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Резерв.ЗарезервированоОстаток, 0) КАК Зарезервировано
		|ИЗ
		|	РегистрНакопления.Резервы.Остатки(
		|		, Склад = &Склад И Номенклатура = &Номенклатура) КАК Резерв";
		ЗапросРезерва.УстановитьПараметр("Склад", Склад);
		ЗапросРезерва.УстановитьПараметр("Номенклатура", Товар);

		Зарезервировано = 0;
		ВыборкаРезерва = ЗапросРезерва.Выполнить().Выбрать();
		Если ВыборкаРезерва.Следующий() Тогда
			Зарезервировано = ВыборкаРезерва.Зарезервировано;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Номенклатура = ВыборкаНаличия.Номенклатура;
		НоваяСтрока.Свободно = ВыборкаНаличия.ВНаличии - Зарезервировано;

	КонецЦикла;

	Возврат Результат;

КонецФункции
