// Эталон B28: остатки на дату из виртуальной таблицы, расходы за интервал — из основной таблицы регистра.

Функция ЗалежалыеТовары(ДатаАнализа, КоличествоДней) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаАнализа, ) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|	И НЕ Остатки.Номенклатура В
	|				(ВЫБРАТЬ
	|					Движения.Номенклатура
	|				ИЗ
	|					РегистрНакопления.ТоварыНаСкладах КАК Движения
	|				ГДЕ
	|					Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					И Движения.Период >= &НачалоИнтервала
	|					И Движения.Период < &ДатаАнализа)";
	Запрос.УстановитьПараметр("ДатаАнализа", ДатаАнализа);
	Запрос.УстановитьПараметр("НачалоИнтервала", ДатаАнализа - КоличествоДней * 86400);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");

КонецФункции
