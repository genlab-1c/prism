// Проверки B28 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 4; Лог = "";
	СоздатьФикстуры();

	Т1 = Спр("Номенклатура", "Товар 1");
	Т2 = Спр("Номенклатура", "Товар 2");
	Т3 = Спр("Номенклатура", "Товар 3");
	Т4 = Спр("Номенклатура", "Товар 4");

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2026, 4, 1), 30);
		Если Р.Количество() = 2 И Содержит(Р, Т2) И Содержит(Р, Т4) Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (на 01.04 за 30 дней: ждали Товар 2 и Товар 4); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2026, 4, 1), 30);
		Если НЕ Содержит(Р, Т1) И НЕ Содержит(Р, Т3) Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (на 01.04 за 30 дней: Товар 1 (недавний расход) и Товар 3 (нет остатка) не залежалые); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2026, 4, 1), 5);
		Если Р.Количество() = 3 И Содержит(Р, Т1) Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (на 01.04 за 5 дней: расход Товара 1 был раньше интервала, ждали 3 товара); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2026, 1, 22), 30);
		Если Р.Количество() = 2 И Содержит(Р, Т1) И Содержит(Р, Т3) И НЕ Содержит(Р, Т2) Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (на 22.01 за 30 дней: ждали Товар 1 и Товар 3, Товар 2 продавался 20.01); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции

// Есть ли ссылка в результате: массив или таблица значений.
Функция Содержит(Результат, Ссылка)
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Возврат Результат.Найти(Ссылка) <> Неопределено;
	КонецЕсли;
	Для Каждого Стр Из Результат Цикл
		Для Каждого Колонка Из Результат.Колонки Цикл
			Если Стр[Колонка.Имя] = Ссылка Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции
