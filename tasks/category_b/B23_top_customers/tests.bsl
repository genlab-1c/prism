// Проверки B23 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 4; Лог = "";
	СоздатьФикстуры();

	К1 = Спр("Контрагенты", "ООО Альфа");
	К2 = Спр("Контрагенты", "ООО Бета");
	К3 = Спр("Контрагенты", "ООО Гамма");

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2026, 1, 1), Дата(2026, 2, 28), 2);
		Если Р.Количество() = 2 И НайтиСтроку(Р, К1) = Р[0] И ЧисловаяКолонка(Р, Р[0]) = 1200 И НайтиСтроку(Р, К2) = Р[1] И ЧисловаяКолонка(Р, Р[1]) = 900 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (январь-февраль, первые 2: ждали Альфа 1200, затем Бета 900); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2026, 1, 1), Дата(2026, 2, 28), 10);
		Если Р.Количество() = 3 И НайтиСтроку(Р, К3) = Р[2] И ЧисловаяКолонка(Р, Р[2]) = 300 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (январь-февраль, первые 10: ждали 3 строки, последняя Гамма 300); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2026, 1, 1), Дата(2026, 1, 31), 1);
		Если Р.Количество() = 1 И НайтиСтроку(Р, К2) = Р[0] И ЧисловаяКолонка(Р, Р[0]) = 900 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (январь, первый 1: ждали Бета 900); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}(Дата(2025, 1, 1), Дата(2025, 12, 31), 5);
		Если Р.Количество() = 0 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (период без продаж: ждали пустую таблицу); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции

// Строка таблицы, в любой колонке которой стоит заданная ссылка.
Функция НайтиСтроку(ТЗ, Ссылка)
	Для Каждого Стр Из ТЗ Цикл
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			Если Стр[Колонка.Имя] = Ссылка Тогда
				Возврат Стр;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Первая числовая колонка строки — без привязки к имени колонки кандидата.
Функция ЧисловаяКолонка(ТЗ, Стр)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Значение = Стр[Колонка.Имя];
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Значение колонки, имя которой начинается с заданной части (без учёта регистра).
Функция КолонкаПоИмени(ТЗ, Стр, НачалоИмени)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Если СтрНачинаетсяС(ВРег(Колонка.Имя), ВРег(НачалоИмени)) Тогда
			Возврат Стр[Колонка.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
