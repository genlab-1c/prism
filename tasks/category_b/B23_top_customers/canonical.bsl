// Эталон B23: обороты за период с группировкой по покупателю, сортировка и усечение до нужного числа строк.

Функция ТопПокупателей(ДатаНачала, ДатаОкончания, КоличествоПокупателей) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обороты.Контрагент КАК Контрагент,
	|	СУММА(Обороты.СуммаОборот) КАК Сумма
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, , ) КАК Обороты
	|СГРУППИРОВАТЬ ПО
	|	Обороты.Контрагент
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Результат = Запрос.Выполнить().Выгрузить();
	Пока Результат.Количество() > КоличествоПокупателей Цикл
		Результат.Удалить(Результат.Количество() - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции
