// Проверки B27 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 4; Лог = "";
	СоздатьФикстуры();

	К1 = Спр("Контрагенты", "ООО Альфа");
	К2 = Спр("Контрагенты", "ООО Бета");
	К3 = Спр("Контрагенты", "ООО Гамма");
	С1 = Спр("Сотрудники", "Иванов И.И.");

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}();
		Если Р.Количество() = 2 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (ждали 2 строки: Альфа и Бета, получено " + Р.Количество() + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}();
		Если Р.Количество() > 0 И НайтиСтроку(Р, К1) = Р[0] И ЧисловаяКолонка(Р, Р[0]) = 300 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (первая строка: ждали Альфа 300); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}();
		Если Р.Количество() > 1 И НайтиСтроку(Р, К2) = Р[1] И ЧисловаяКолонка(Р, Р[1]) = 100 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (вторая строка: ждали Бета 100); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}();
		Если НайтиСтроку(Р, С1) = Неопределено И НайтиСтроку(Р, К3) = Неопределено Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (сотрудник и погашенный долг в результат не входят); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции

// Строка таблицы, в любой колонке которой стоит заданная ссылка.
Функция НайтиСтроку(ТЗ, Ссылка)
	Для Каждого Стр Из ТЗ Цикл
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			Если Стр[Колонка.Имя] = Ссылка Тогда
				Возврат Стр;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Первая числовая колонка строки — без привязки к имени колонки кандидата.
Функция ЧисловаяКолонка(ТЗ, Стр)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Значение = Стр[Колонка.Имя];
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Значение колонки, имя которой начинается с заданной части (без учёта регистра).
Функция КолонкаПоИмени(ТЗ, Стр, НачалоИмени)
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Если СтрНачинаетсяС(ВРег(Колонка.Имя), ВРег(НачалоИмени)) Тогда
			Возврат Стр[Колонка.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
