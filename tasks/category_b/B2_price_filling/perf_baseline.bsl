// Якорь оси O для B2: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «срез последних в цикле»: вместо одного среза на всю табличную часть идём по
// строкам и на КАЖДУЮ выполняем свой запрос к регистру сведений. Число обращений растёт
// линейно с числом строк табличной части (см. perf.yaml, count: sdbl).
// Семантика та же: цены нет → 0, сумма = количество × цена.

Процедура ЗаполнитьЦеныТабличнойЧасти(ТабличнаяЧасть, ВидЦен, ДатаЦен) Экспорт

	Для Каждого Строка Из ТабличнаяЧасть Цикл

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Цены.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|		&ДатаЦен, ВидЦен = &ВидЦен И Номенклатура = &Номенклатура) КАК Цены";
		Запрос.УстановитьПараметр("ДатаЦен", ДатаЦен);
		Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
		Запрос.УстановитьПараметр("Номенклатура", Строка.Номенклатура);

		Цена = 0;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Цена = Выборка.Цена;
		КонецЕсли;

		Строка.Цена = Цена;
		Строка.Сумма = Строка.Количество * Строка.Цена;

	КонецЦикла;

КонецПроцедуры
