// Якорь оси O для B15: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «запрос в цикле»: вместо одного обращения к виртуальной таблице оборотов
// перебираем номенклатуру и на КАЖДЫЙ товар выполняем свой запрос оборота. Число
// обращений растёт линейно с числом товаров (см. perf.yaml, count: sdbl).
// Классификация и границы классов — те же, что у эталона, ответ совпадает.

Функция КлассификацияABC(НачалоПериода, КонецПериода) Экспорт

	// Шаг 1. Список номенклатуры — отдельным запросом (сами обороты возьмём поштучно).
	ЗапросНоменклатуры = Новый Запрос;
	// Справочник в этой задаче неиерархический — групп нет, отбирать нечего.
	ЗапросНоменклатуры.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";

	ТаблицаОборотов = Новый ТаблицаЗначений;
	ТаблицаОборотов.Колонки.Добавить("Номенклатура");
	ТаблицаОборотов.Колонки.Добавить("СуммаОборот", Новый ОписаниеТипов("Число"));

	// Шаг 2. Оборот по каждому товару — СВОИМ запросом. Это и есть капкан.
	ВыборкаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выбрать();
	Пока ВыборкаНоменклатуры.Следующий() Цикл

		ЗапросОборота = Новый Запрос;
		ЗапросОборота.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ОборотыПродаж.СуммаОборот), 0) КАК СуммаОборот
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|		&НачалоПериода, &КонецПериода, , Номенклатура = &Номенклатура) КАК ОборотыПродаж";
		ЗапросОборота.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросОборота.УстановитьПараметр("КонецПериода", КонецПериода);
		ЗапросОборота.УстановитьПараметр("Номенклатура", ВыборкаНоменклатуры.Ссылка);

		ВыборкаОборота = ЗапросОборота.Выполнить().Выбрать();
		ВыборкаОборота.Следующий();
		Оборот = ВыборкаОборота.СуммаОборот;

		// Товары без оборота за период в классификацию не попадают — как и у эталона,
		// где виртуальная таблица оборотов их просто не отдаёт.
		Если Оборот = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаОборотов.Добавить();
		НоваяСтрока.Номенклатура = ВыборкаНоменклатуры.Ссылка;
		НоваяСтрока.СуммаОборот = Оборот;

	КонецЦикла;

	// Шаг 3. Дальше — ровно как у эталона: сортировка по убыванию оборота,
	// накопительная доля, границы 80 / 95.
	ТаблицаОборотов.Сортировать("СуммаОборот УБЫВ");

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Класс", Новый ОписаниеТипов("Строка"));

	ОбщийОборот = ТаблицаОборотов.Итог("СуммаОборот");
	Если ОбщийОборот = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	НакопленнаяСумма = 0;
	Для Каждого СтрокаОборота Из ТаблицаОборотов Цикл
		НакопленнаяСумма = НакопленнаяСумма + СтрокаОборота.СуммаОборот;
		НакопленнаяДоля = НакопленнаяСумма / ОбщийОборот * 100;

		Если НакопленнаяДоля <= 80 Тогда
			Класс = "A";
		ИначеЕсли НакопленнаяДоля <= 95 Тогда
			Класс = "B";
		Иначе
			Класс = "C";
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Номенклатура = СтрокаОборота.Номенклатура;
		НоваяСтрока.Класс = Класс;
	КонецЦикла;

	Возврат Результат;

КонецФункции
