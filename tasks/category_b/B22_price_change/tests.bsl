// Проверки B22 — формат раннера категории B PRISM. СоздатьФикстуры() и Спр() генерируются из fixtures.yaml.

Функция ПрогнатьТест() Экспорт
	Прошло = 0; Всего = 5; Лог = "";
	СоздатьФикстуры();

	Т1 = Спр("Номенклатура", "Товар 1");
	Т2 = Спр("Номенклатура", "Товар 2");
	Т3 = Спр("Номенклатура", "Товар 3");

	// Тест 1
	Попытка
		Р = КодКандидата.{{ENTRY}}(Т1, Дата(2026, 1, 15), Дата(2026, 3, 1));
		Если Р = 20 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест1 FAIL (с 15.01 по 01.03 ждали 120 - 100 = 20, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест1 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 2
	Попытка
		Р = КодКандидата.{{ENTRY}}(Т1, Дата(2026, 1, 15), Дата(2026, 4, 1));
		Если Р = 50 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест2 FAIL (с 15.01 по 01.04 ждали 150 - 100 = 50, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест2 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 3
	Попытка
		Р = КодКандидата.{{ENTRY}}(Т2, Дата(2026, 1, 15), Дата(2026, 3, 1));
		Если Р = 50 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест3 FAIL (цены на начало нет, ждали 50 - 0 = 50, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест3 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 4
	Попытка
		Р = КодКандидата.{{ENTRY}}(Т3, Дата(2026, 1, 15), Дата(2026, 4, 1));
		Если Р = 0 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест4 FAIL (цен нет вовсе, ждали 0, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест4 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	// Тест 5
	Попытка
		Р = КодКандидата.{{ENTRY}}(Т1, Дата(2025, 12, 1), Дата(2026, 1, 15));
		Если Р = 100 Тогда
			Прошло = Прошло + 1;
		Иначе
			Лог = Лог + "тест5 FAIL (до первой цены, ждали 100 - 0 = 100, получено " + Р + "); ";
		КонецЕсли;
	Исключение
		Лог = Лог + "тест5 ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки() + "; ";
	КонецПопытки;

	Возврат "PASSED=" + Прошло + ";TOTAL=" + Всего + ";" + Лог;
КонецФункции
