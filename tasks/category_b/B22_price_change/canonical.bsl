// Эталон B22: два среза последних — на конец и на начало периода.

Функция ИзменениеЦеныЗаПериод(Номенклатура, ДатаНачала, ДатаОкончания) Экспорт

	Возврат ЦенаНаДату(Номенклатура, ДатаОкончания) - ЦенаНаДату(Номенклатура, ДатаНачала);

КонецФункции

Функция ЦенаНаДату(Номенклатура, ДатаЦены)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныПродажи.СрезПоследних(&ДатаЦены, Номенклатура = &Номенклатура) КАК Цены";
	Запрос.УстановитьПараметр("ДатаЦены", ДатаЦены);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	Возврат 0;

КонецФункции
