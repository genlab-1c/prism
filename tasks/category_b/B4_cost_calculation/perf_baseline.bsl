// Якорь оси O для B4: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «запрос в цикле»: вместо одного обращения к виртуальной таблице с отбором
// «Номенклатура В (&Массив)» идём по массиву и на КАЖДУЮ позицию делаем свой запрос.
// Число обращений растёт линейно с размером массива (см. perf.yaml, count: sdbl).
// Семантика та же: позиция без остатков даёт среднюю цену 0 и в ответе присутствует.

Функция РассчитатьСебестоимость(МассивНоменклатуры, Склад, ДатаРасчета) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("СредняяЦена", Новый ОписаниеТипов("Число"));

	Если МассивНоменклатуры = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Номенклатура Из МассивНоменклатуры Цикл

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Остатки.КоличествоОстаток, 0) = 0 ТОГДА 0
		|		ИНАЧЕ Остатки.СтоимостьОстаток / Остатки.КоличествоОстаток
		|	КОНЕЦ КАК СредняяЦена
		|ИЗ
		|	РегистрНакопления.СтоимостьТоваров.Остатки(
		|		&ДатаРасчета, Склад = &Склад И Номенклатура = &Номенклатура) КАК Остатки";
		Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

		Строка = Результат.Добавить();
		Строка.Номенклатура = Номенклатура;

		Выборка = Запрос.Выполнить().Выбрать();
		// Остатков нет — виртуальная таблица строки не отдаёт, средняя цена 0.
		Строка.СредняяЦена = ?(Выборка.Следующий(), Выборка.СредняяЦена, 0);

	КонецЦикла;

	Возврат Результат;

КонецФункции
