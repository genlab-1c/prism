// Якорь оси O для B16: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «чтение реквизитов через ссылку в цикле»: отбор по владельцу оставляем в
// запросе, но интервал дат проверяем, читая .ДатаНачала/.ДатаОкончания через точку у
// каждого договора. Каждое чтение — отдельный поход за объектом, поэтому число обращений
// растёт линейно с числом договоров контрагента (см. perf.yaml, count: sdbl).

Функция ДействующийДоговор(Контрагент, ДатаСреза) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	// Из подходящих берём договор с максимальной ДатаНачала — та же семантика, что у
	// эталона (УПОРЯДОЧИТЬ ПО ДатаНачала УБЫВ, ПЕРВЫЕ 1).
	Лучший = Неопределено;
	ЛучшаяДата = Дата(1, 1, 1);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Договор = Выборка.Ссылка;
		ДатаНачала = Договор.ДатаНачала;          // поход в СУБД за объектом
		ДатаОкончания = Договор.ДатаОкончания;    // и ещё один

		Если ДатаНачала > ДатаСреза Тогда
			Продолжить;
		КонецЕсли;
		// Пустая дата окончания = ДАТАВРЕМЯ(1,1,1) → договор бессрочный.
		Если ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания < ДатаСреза Тогда
			Продолжить;
		КонецЕсли;

		Если Лучший = Неопределено ИЛИ ДатаНачала > ЛучшаяДата Тогда
			Лучший = Договор;
			ЛучшаяДата = ДатаНачала;
		КонецЕсли;

	КонецЦикла;

	Возврат Лучший;

КонецФункции
