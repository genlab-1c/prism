// Якорь оси O для B17: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «подними строки и сложи в коде»: обращений к СУБД столько же, сколько у эталона
// (один запрос), но из базы поднимается строка на КАЖДЫЙ договор контрагента, и объём
// растёт вместе с базой. Счёт обращений (count: sdbl) этот порок не видит — он виден
// только по числу строк (count: rows), ради чего якорь и написан.
//
// Это не выдумка: ровно так решили B17 живые модели июньского прогона (Claude Sonnet 5,
// Gemini 3.5 Flash Lite, MiMo-V2.5 Pro) — 83 строки против 2 у эталона на базе 80.

Функция ДолгКонтрагента(Контрагент) Экспорт

	// Остаток в разрезе договора — тем же отбором, что у эталона (семантика та же:
	// аванс, отрицательный остаток, в долг не идёт). Разница лишь в том, ГДЕ суммируем.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Договор КАК Договор,
	|	Остатки.СуммаОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.Взаиморасчеты.Остатки(, Договор.Владелец = &Контрагент) КАК Остатки";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	// Сложение в коде: платформа поднимает все строки договоров в память приложения.
	Долг = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Остаток > 0 Тогда
			Долг = Долг + Выборка.Остаток;
		КонецЕсли;
	КонецЦикла;

	Возврат Долг;

КонецФункции
