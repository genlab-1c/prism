// Якорь оси O для B6: решение КОРРЕКТНОЕ (проходит tests.bsl на 100%), но дорогое.
// Порок — «запрос в цикле»: вместо одного обращения к виртуальной таблице оборотов
// перебираем номенклатуру и на КАЖДЫЙ товар выполняем свой запрос. Число обращений
// растёт линейно с числом товаров (см. perf.yaml, count: sdbl). Ответ совпадает
// с эталоном: строка появляется только там, где за период были движения.

Функция ПолучитьОбороты(НачалоПериода, КонецПериода, Склад = Неопределено) Экспорт

	ЗапросНоменклатуры = Новый Запрос;
	// Справочник в этой задаче неиерархический — групп нет, отбирать нечего.
	ЗапросНоменклатуры.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	// Условие по складу — то же, что у эталона: необязательное.
	УсловиеСклада = ?(ЗначениеЗаполнено(Склад), " И Склад = &Склад", "");

	ВыборкаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выбрать();
	Пока ВыборкаНоменклатуры.Следующий() Цикл

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ОборотыПродаж.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ОборотыПродаж.КоличествоОборот, 0) КАК Количество,
		|	ЕСТЬNULL(ОборотыПродаж.СуммаОборот, 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|		&НачалоПериода, &КонецПериода, ,
		|		Номенклатура = &Номенклатура" + УсловиеСклада + ") КАК ОборотыПродаж";

		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("Номенклатура", ВыборкаНоменклатуры.Ссылка);
		Если ЗначениеЗаполнено(Склад) Тогда
			Запрос.УстановитьПараметр("Склад", Склад);
		КонецЕсли;

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Номенклатура = Выборка.Номенклатура;
			НоваяСтрока.Количество = Выборка.Количество;
			НоваяСтрока.Сумма = Выборка.Сумма;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции
